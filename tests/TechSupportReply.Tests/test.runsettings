<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <RunConfiguration>
    <TargetPlatform>x64</TargetPlatform>
    <!-- 실제 유료 API를 부르는 통합 테스트(Category=Integration)는 수동 실행 범주라 기본 실행에서 뺀다.
         명령줄 필터는 이 값과 AND로 합쳐지므로, 통합 테스트는 integration.runsettings로 실행한다(설치가이드 개발자 주의 참고). -->
    <TestCaseFilter>Category!=Integration</TestCaseFilter>
  </RunConfiguration>
</RunSettings>
